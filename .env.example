# Copy this file to .env to change the models Sentia serves.

# Space-separated Ollama models pulled at startup and shared by every Luna app.
# Each app chooses which of these it uses (Visia: VISION_MODEL, Fiora: OLLAMA_MODEL,
# Lexia: DOCUMENT_MODEL, and EMBEDDING_MODEL for semantic search; Socia: LUNASOCIA_CHAT_MODEL).
SENTIA_MODELS=qwen3-vl:8b-instruct qwen3-embedding:0.6b huihui_ai/qwen3-abliterated:14b

# Ollama: memory-saving attention (KV cache types: f16, q8_0, q4_0), and requests per
# model at once; Ollama does not run Qwen3-VL requests in parallel, so keep it at 1.
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Residency: the one model that lives on the GPU (Luna Socia's chat model), at the context
# Socia asks for (LUNASOCIA_CONTEXT_TOKENS). Other models stay loaded only this long after
# their last request; once the GPU has been quiet this many seconds and has room, the
# resident model is loaded back. Leave SENTIA_RESIDENT_MODEL blank to turn this off.
SENTIA_RESIDENT_MODEL=huihui_ai/qwen3-abliterated:14b
SENTIA_RESIDENT_CONTEXT=8192
SENTIA_GUEST_KEEP_ALIVE=2m
SENTIA_RESIDENT_IDLE_SECONDS=30

# Passwords, tokens and sign-in. A fresh clone needs none of these: each has a default
# for localhost (lunasentia-dev, luna<app>-dev, luna<app>-dev-token-for-localhost-only),
# and without Google the owner signs in with one click on localhost. Before you give
# Sentia or an app a public (https) address, set your own: luna.sh refuses to start a
# public stack that still uses a default. Generate values with `openssl rand -hex 24`.
#
# Shared PostgreSQL (luna-sentia-db): the superuser, and Sentia's own two roles. Set these
# before the first start; afterwards the database keeps the password it was created with.
# SENTIA_POSTGRES_PASSWORD=lunasentia-dev
# LUNAAUTH_DB_PASSWORD=lunasentia-dev
# LUNAMONITOR_DB_PASSWORD=lunasentia-dev
# Each app's database role password; each must equal POSTGRES_PASSWORD in that app's .env.
# LUNAVISIA_DB_PASSWORD=lunavisia-dev
# LUNAVITA_DB_PASSWORD=lunavita-dev
# LUNALUMIA_DB_PASSWORD=lunalumia-dev
# LUNAFIORA_DB_PASSWORD=lunafiora-dev
# LUNALEXIA_DB_PASSWORD=lunalexia-dev
# LUNAVIBIA_DB_PASSWORD=lunavibia-dev
# LUNASOCIA_DB_PASSWORD=lunasocia-dev

# Single sign-on for every Luna app. The public URL is the address people's browsers
# reach the auth service at; the cookie domain is the parent domain of every app. These
# defaults are for localhost without a tunnel. With a tunnel, route a hostname to
# 127.0.0.1:19001 and set, for example, https://auth.example.com and example.com.
SENTIA_AUTH_PUBLIC_URL=http://localhost:19001
SENTIA_AUTH_COOKIE_DOMAIN=
# Google sign-in: a Google OAuth "Web application" client with
# <SENTIA_AUTH_PUBLIC_URL>/callback as a redirect URI (one of the apps' UI clients works),
# and the Google account that owns the home's lights and speakers and manages everyone at
# /admin. Without them, only the owner can sign in, by one click on localhost.
# SENTIA_AUTH_GOOGLE_CLIENT_ID=
# SENTIA_AUTH_GOOGLE_CLIENT_SECRET=
# SENTIA_AUTH_OWNER_EMAIL=you@example.com
# Signs the sign-in state; at least 32 characters.
# SENTIA_AUTH_SECRET=lunasentia-dev-auth-secret-localhost-only
# Each app's API token, the same value as in that app's .env, for deleting a person's data
# there and asking about its models.
# LUNAVISIA_API_TOKEN=lunavisia-dev-token-for-localhost-only
# LUNAVITA_API_TOKEN=lunavita-dev-token-for-localhost-only
# LUNALUMIA_API_TOKEN=lunalumia-dev-token-for-localhost-only
# LUNAFIORA_API_TOKEN=lunafiora-dev-token-for-localhost-only
# LUNALEXIA_API_TOKEN=lunalexia-dev-token-for-localhost-only
# LUNAVIBIA_API_TOKEN=lunavibia-dev-token-for-localhost-only
# Days a sign-in lasts before signing in again.
SENTIA_AUTH_SESSION_DAYS=30

# The model monitor's page, for the owner. With a tunnel, route a hostname to
# 127.0.0.1:19003 under SENTIA_AUTH_COOKIE_DOMAIN (e.g. https://monitor.example.com), so the sign-in reaches it.
SENTIA_MONITOR_PUBLIC_URL=http://localhost:19003
# ComfyUI's own page, for the owner, which the monitor serves on 127.0.0.1:19002 behind the
# sign-in. With a tunnel, route a hostname there under SENTIA_AUTH_COOKIE_DOMAIN
# (e.g. https://comfyui.example.com).
SENTIA_COMFYUI_PUBLIC_URL=http://localhost:19002
# The owner's MCP server (the GPU, its models, and every model call, read only), which the
# monitor serves on 127.0.0.1:18003. With a tunnel, route a hostname there under
# SENTIA_AUTH_COOKIE_DOMAIN (e.g. https://sentia-mcp.example.com) and add .../mcp as a connector.
SENTIA_MCP_PUBLIC_URL=http://localhost:18003
# Days of GPU samples (five-second summaries) and of model calls the monitor keeps.
MONITOR_SAMPLE_DAYS=30
MONITOR_CALL_DAYS=365

