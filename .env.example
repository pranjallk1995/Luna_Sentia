# Copy this file to .env to change the models Sentia serves.

# Space-separated Ollama models pulled at startup and shared by every Luna app.
# Each app chooses which of these it uses (Visia: VISION_MODEL, Fiora: OLLAMA_MODEL,
# Lexia: DOCUMENT_MODEL, and EMBEDDING_MODEL for semantic search; Socia: LUNASOCIA_CHAT_MODEL).
SENTIA_MODELS=qwen3-vl:8b-instruct qwen3-embedding:0.6b qwen3:14b

# Ollama: memory-saving attention (KV cache types: f16, q8_0, q4_0), and requests per
# model at once; Ollama does not run Qwen3-VL requests in parallel, so keep it at 1.
OLLAMA_NUM_PARALLEL=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# Residency: the one model that lives on the GPU (Luna Socia's chat model), at the context
# Socia asks for (LUNASOCIA_CONTEXT_TOKENS). Other models stay loaded only this long after
# their last request; once the GPU has been quiet this many seconds and has room, the
# resident model is loaded back. Leave SENTIA_RESIDENT_MODEL blank to turn this off.
SENTIA_RESIDENT_MODEL=qwen3:14b
SENTIA_RESIDENT_CONTEXT=8192
SENTIA_GUEST_KEEP_ALIVE=2m
SENTIA_RESIDENT_IDLE_SECONDS=30

# Shared PostgreSQL for every Luna app (luna-sentia-db). The superuser password is
# private to Sentia; generate one with `openssl rand -hex 24`.
SENTIA_POSTGRES_PASSWORD=replace-with-a-private-random-value
# Each app's database role password. Each must equal POSTGRES_PASSWORD in that app's .env.
LUNAVISIA_DB_PASSWORD=lunavisia-dev
LUNAVITA_DB_PASSWORD=lunavita-dev
LUNALUMIA_DB_PASSWORD=lunalumia-dev
LUNAFIORA_DB_PASSWORD=lunafiora-dev
LUNALEXIA_DB_PASSWORD=lunalexia-dev
LUNAVIBIA_DB_PASSWORD=lunavibia-dev
LUNASOCIA_DB_PASSWORD=lunasocia-dev
# Password of Sentia's sign-on service role (lunaauth).
LUNAAUTH_DB_PASSWORD=replace-with-a-private-random-value
# Password of Sentia's model monitor role (lunamonitor).
LUNAMONITOR_DB_PASSWORD=replace-with-a-private-random-value

# Single sign-on for every Luna app. The public URL is the address people's browsers
# reach the auth service at (route it to 127.0.0.1:19090); the cookie domain is the
# parent domain of every app (leave blank for localhost-only use).
SENTIA_AUTH_PUBLIC_URL=https://auth.example.com
SENTIA_AUTH_COOKIE_DOMAIN=example.com
# A Google OAuth "Web application" client with <SENTIA_AUTH_PUBLIC_URL>/callback as a
# redirect URI; one of the apps' UI clients works.
SENTIA_AUTH_GOOGLE_CLIENT_ID=replace-with-google-client-id
SENTIA_AUTH_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Signs the sign-in state; at least 32 characters, e.g. `openssl rand -hex 32`.
SENTIA_AUTH_SECRET=replace-with-a-private-random-value-of-at-least-32-characters
# The account that owns the home's lights and speakers and manages everyone at /admin.
SENTIA_AUTH_OWNER_EMAIL=you@example.com
# Each app's API token, the same value as in that app's .env, for deleting a person's data there.
LUNAVISIA_API_TOKEN=
LUNAVITA_API_TOKEN=
LUNALUMIA_API_TOKEN=
LUNAFIORA_API_TOKEN=
LUNALEXIA_API_TOKEN=
LUNAVIBIA_API_TOKEN=
# Days a sign-in lasts before signing in again.
SENTIA_AUTH_SESSION_DAYS=30

# The model monitor's page, for the owner: route this address to 127.0.0.1:19081. Like
# every app it must sit under SENTIA_AUTH_COOKIE_DOMAIN, so the sign-in reaches it.
SENTIA_MONITOR_PUBLIC_URL=https://monitor.example.com
# Days of GPU samples (five-second summaries) and of model calls the monitor keeps.
MONITOR_SAMPLE_DAYS=30
MONITOR_CALL_DAYS=365

